DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/monitoreo_sistemas
ADMIN_PASSWORD=CHANGE_ME
MONITOR_INTERVAL_HOURS=10
MONITOR_TIMEOUT_SECONDS=10
MONITOR_MAX_CONCURRENCY=15
AUTO_CLOSE_TICKETS=true
CORS_ORIGINS=http://localhost:5173
# Off by default - see app/services/forms_service.py before enabling.
GOOGLE_FORMS_ENABLED=false
GOOGLE_FORMS_TIMEOUT_SECONDS=8
GOOGLE_FORMS_MAX_CONCURRENCY=10
# Off by default - see app/services/telegram_service.py before enabling.
# TELEGRAM_BOT_TOKEN se obtiene hablando con @BotFather en Telegram.
# TELEGRAM_CHAT_ID es el id del chat/grupo que debe recibir las alertas
# (se obtiene escribiendole al bot y consultando https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Meses de historial de registro_monitoreo que se conservan antes de
# purgarlo automaticamente (job diario, ver app/services/retencion_service.py).
RETENCION_REGISTROS_MESES=12
