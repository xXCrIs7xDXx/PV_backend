# Copia este archivo como .env y completa los valores. El .env NUNCA se sube
# a GitHub (esta en .gitignore). En Render estas mismas variables se cargan
# en Environment.

# --- Obligatorias ---------------------------------------------------------
# Neon/Postgres. Se acepta la URL tal cual la da Neon
# (postgresql://...?sslmode=require&channel_binding=require): el backend la
# adapta sola a asyncpg.
DATABASE_URL=postgresql://usuario:CHANGE_ME@localhost:5432/monitoreo_sistemas
# Contrasena compartida del modo administrador
ADMIN_PASSWORD=CHANGE_ME

# --- Monitoreo ------------------------------------------------------------
MONITOR_TIMEOUT_SECONDS=30
MONITOR_MAX_CONCURRENCY=15
# Fallos seguidos necesarios para pasar una plataforma a "En Revision"
MONITOR_CONFIRM_FAILURES=2
AUTO_CLOSE_TICKETS=true
# Meses de historial (registro_monitoreo) que se conservan; lo mas antiguo se
# borra despues de cada ciclo de cron-job.org
RETENCION_REGISTROS_MESES=12
# Opcional: si lo defines, cron-job.org debe llamar a
# /api/monitoreo/forzar-ejecucion?token=<CRON_TOKEN>
CRON_TOKEN=

# --- CORS -----------------------------------------------------------------
# Dominios del frontend separados por coma (local y Vercel). "*" = cualquiera.
CORS_ORIGINS=http://localhost:5173

# --- Google Forms (auditoria) ---------------------------------------------
# Solo se envia con el boton "Enviar a Google Forms" del panel: cada envio
# escribe filas REALES en las planillas de la universidad.
GOOGLE_FORMS_TIMEOUT_SECONDS=8
GOOGLE_FORMS_MAX_CONCURRENCY=10

# --- Telegram (alertas) ---------------------------------------------------
# En local dejalo en false para no mandar alertas al grupo real.
# TELEGRAM_BOT_TOKEN: se obtiene con @BotFather.
# TELEGRAM_CHAT_ID: escribe al bot y revisa
#   https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
